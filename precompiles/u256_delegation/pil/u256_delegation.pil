//--PUT A HUGE WARNING HERE ABOUT HOW THIS WAS AI GENERATED AND WAS NOT REVIEWED
require "std_lookup.pil";
require "std_range_check.pil";
require "operations.pil";
require "opids.pil";

/// U256 Delegation Precompile
///
/// Proves 256-bit arithmetic operations delegated via CSR 0x7ca from ZKsyncOS.
/// This follows the Airbender bigint_with_control protocol:
/// - x10 = address of operand A (also destination for result)
/// - x11 = address of operand B
/// - x12 = control mask (operation selector + carry/borrow flag)
///
/// Supported operations (from control mask):
/// - ADD (0x01): A + B with optional carry input
/// - SUB (0x02): A - B with optional borrow input
/// - SUB_NEGATE (0x04): B - A with optional borrow input
/// - MUL_LOW (0x08): Low 256 bits of A * B
/// - MUL_HIGH (0x10): High 256 bits of A * B
/// - EQ (0x20): Compare A == B (result in overflow flag)
/// - MEMCPY (0x80): Copy B to A (with +1 if carry set)
///
/// Parameters:
/// - N: number of rows per instance
/// - operation_bus_id: bus ID for operation proving
///
/// Integration:
/// - Main assumes an operation on operation_bus_id:
///   [ OP_U256_DELEGATION, step, control, addr_a, addr_b, overflow, 0, 0 ]

airtemplate U256Delegation(const int N = 2**20, const int operation_bus_id = OPERATION_BUS_ID) {
    // Number of 32-bit limbs (256 bits / 32 = 8 limbs)
    const int N_LIMBS = 8;

    // Witness columns for operands (8 x 32-bit limbs each)
    col witness bits(32) a[N_LIMBS];
    col witness bits(32) b[N_LIMBS];

    // Result chunks in 16-bit pieces (for range checking)
    col witness bits(16) r_lo[N_LIMBS];
    col witness bits(16) r_hi[N_LIMBS];

    // Addresses
    col witness bits(32) addr_a;
    col witness bits(32) addr_b;

    // Control mask and step
    col witness bits(8) control;
    col witness bits(40) step;

    // Operation selectors (exactly one set when sel=1)
    col witness bits(1) is_add;
    col witness bits(1) is_sub;
    col witness bits(1) is_sub_neg;
    col witness bits(1) is_mul_low;
    col witness bits(1) is_mul_high;
    col witness bits(1) is_eq;
    col witness bits(1) is_memcpy;

    // Carry/borrow input flag (bit 6 of control)
    col witness bits(1) carry_in;

    // Intermediate carries for arithmetic (9 total: c[0]=carry_in, c[8]=overflow)
    col witness bits(1) carry[N_LIMBS + 1];

    // Overflow/result flag
    col witness bits(1) overflow;

    // Row selector
    col witness bits(1) sel;

    // Boolean constraint for selector
    sel * (1 - sel) === 0;

    // Boolean constraints for operation selectors
    is_add * (1 - is_add) === 0;
    is_sub * (1 - is_sub) === 0;
    is_sub_neg * (1 - is_sub_neg) === 0;
    is_mul_low * (1 - is_mul_low) === 0;
    is_mul_high * (1 - is_mul_high) === 0;
    is_eq * (1 - is_eq) === 0;
    is_memcpy * (1 - is_memcpy) === 0;
    carry_in * (1 - carry_in) === 0;

    // Exactly one operation type selected when active
    sel * (is_add + is_sub + is_sub_neg + is_mul_low + is_mul_high + is_eq + is_memcpy - 1) === 0;

    // Carry/borrow boolean constraints
    for (int i = 0; i <= N_LIMBS; i++) {
        carry[i] * (1 - carry[i]) === 0;
    }

    // First carry is the input carry
    sel * (carry[0] - carry_in) === 0;

    // Result reconstruction: result[i] = r_lo[i] + r_hi[i] * 2^16
    const expr result[N_LIMBS];
    for (int i = 0; i < N_LIMBS; i++) {
        result[i] = r_lo[i] + r_hi[i] * 2**16;

        // Range checks on result chunks
        range_check(expression: r_lo[i], min: 0, max: 2**16 - 1, sel: sel);
        range_check(expression: r_hi[i], min: 0, max: 2**16 - 1, sel: sel);
    }

    // === ADDITION CONSTRAINTS ===
    // For ADD: a[i] + b[i] + carry[i] = result[i] + carry[i+1] * 2^32
    for (int i = 0; i < N_LIMBS; i++) {
        sel * is_add * (a[i] + b[i] + carry[i] - result[i] - carry[i+1] * 2**32) === 0;
    }
    sel * is_add * (overflow - carry[N_LIMBS]) === 0;

    // === SUBTRACTION CONSTRAINTS ===
    // For SUB: a[i] - b[i] - borrow[i] = result[i] - borrow[i+1] * 2^32
    // Rearranged: a[i] + borrow[i+1] * 2^32 = result[i] + b[i] + borrow[i]
    for (int i = 0; i < N_LIMBS; i++) {
        sel * is_sub * (a[i] + carry[i+1] * 2**32 - result[i] - b[i] - carry[i]) === 0;
    }
    sel * is_sub * (overflow - carry[N_LIMBS]) === 0;

    // === SUB_NEGATE CONSTRAINTS ===
    // For SUB_NEG (B - A): b[i] - a[i] - borrow[i] = result[i] - borrow[i+1] * 2^32
    for (int i = 0; i < N_LIMBS; i++) {
        sel * is_sub_neg * (b[i] + carry[i+1] * 2**32 - result[i] - a[i] - carry[i]) === 0;
    }
    sel * is_sub_neg * (overflow - carry[N_LIMBS]) === 0;

    // === EQUALITY CONSTRAINTS ===
    // For EQ: all limbs must match, overflow indicates equality
    // Note: Result is unchanged (copy of a), overflow = (a == b)
    for (int i = 0; i < N_LIMBS; i++) {
        sel * is_eq * (result[i] - a[i]) === 0;
    }

    // Auxiliary columns for equality check using inverse trick:
    // eq_diff_nz[i] = 1 if a[i] != b[i], 0 otherwise
    // eq_diff_inv[i] = inverse of (a[i] - b[i]) when non-zero (arbitrary when zero)
    col witness bits(1) eq_diff_nz[N_LIMBS];
    col witness bits(64) eq_diff_inv[N_LIMBS];

    // For each limb, verify eq_diff_nz correctly indicates if a[i] != b[i]
    for (int i = 0; i < N_LIMBS; i++) {
        // Boolean constraint for eq_diff_nz
        eq_diff_nz[i] * (1 - eq_diff_nz[i]) === 0;

        // If a[i] != b[i], then eq_diff_inv[i] is the inverse and eq_diff_nz[i] = 1
        // Constraint: (a[i] - b[i]) * eq_diff_inv[i] = eq_diff_nz[i]
        sel * is_eq * ((a[i] - b[i]) * eq_diff_inv[i] - eq_diff_nz[i]) === 0;

        // If eq_diff_nz[i] = 0, then a[i] - b[i] must be 0
        // Constraint: (1 - eq_diff_nz[i]) * (a[i] - b[i]) = 0
        sel * is_eq * (1 - eq_diff_nz[i]) * (a[i] - b[i]) === 0;
    }

    // Sum of all non-zero indicators: if any limb differs, eq_any_diff > 0
    const expr eq_any_diff = eq_diff_nz[0] + eq_diff_nz[1] + eq_diff_nz[2] + eq_diff_nz[3]
                           + eq_diff_nz[4] + eq_diff_nz[5] + eq_diff_nz[6] + eq_diff_nz[7];

    // Inverse for checking if eq_any_diff is zero
    col witness bits(64) eq_any_diff_inv;

    // overflow = 1 iff eq_any_diff = 0 (i.e., all limbs match)
    // Constraint 1: eq_any_diff * eq_any_diff_inv = 1 - overflow
    // (if eq_any_diff != 0, then overflow must be 0)
    sel * is_eq * (eq_any_diff * eq_any_diff_inv - (1 - overflow)) === 0;

    // Constraint 2: overflow * eq_any_diff = 0
    // (if overflow = 1, then eq_any_diff must be 0)
    sel * is_eq * overflow * eq_any_diff === 0;

    // === MEMCPY CONSTRAINTS ===
    // For MEMCPY: result = b (or b+1 if carry_in)
    // When carry_in=0: result = b
    // When carry_in=1: result = b + 1 (with carry propagation)
    for (int i = 0; i < N_LIMBS; i++) {
        sel * is_memcpy * (1 - carry_in) * (result[i] - b[i]) === 0;
    }
    // MEMCPY with carry_in=1 uses same addition logic as ADD with a=0
    for (int i = 0; i < N_LIMBS; i++) {
        if (i == 0) {
            sel * is_memcpy * carry_in * (b[i] + 1 - result[i] - carry[i+1] * 2**32) === 0;
        } else {
            sel * is_memcpy * carry_in * (b[i] + carry[i] - result[i] - carry[i+1] * 2**32) === 0;
        }
    }
    sel * is_memcpy * carry_in * (overflow - carry[N_LIMBS]) === 0;
    sel * is_memcpy * (1 - carry_in) * overflow === 0;  // No overflow when just copying

    // === MEMORY INTERFACE ===
    // Read operands from memory
    for (int i = 0; i < N_LIMBS / 2; i++) {
        // Read a[2i] and a[2i+1] as a 64-bit value
        precompiled_mem_load(addr: addr_a + i * 8, main_step: step, value: [a[2*i], a[2*i+1]], sel: sel);
        precompiled_mem_load(addr: addr_b + i * 8, main_step: step, value: [b[2*i], b[2*i+1]], sel: sel);
        // Write result[2i] and result[2i+1] as a 64-bit value
        precompiled_mem_store(addr: addr_a + i * 8, main_step: step, value: [result[2*i], result[2*i+1]], sel: sel);
    }

    // === MULTIPLICATION CONSTRAINTS ===
    // Full 256-bit multiplication produces a 512-bit result.
    // MUL_LOW returns the low 256 bits, MUL_HIGH returns the high 256 bits.
    //
    // We use schoolbook multiplication with 32-bit limbs:
    // For A[0..7] * B[0..7], the 512-bit product P[0..15] is computed as:
    //   P[k] = sum_{i+j=k} A[i] * B[j]  (with carries from lower positions)
    //
    // Auxiliary witness columns for multiplication
    col witness bits(64) mul_pp_lo[N_LIMBS];   // Partial product accumulator for low half
    col witness bits(64) mul_pp_hi[N_LIMBS];   // Partial product accumulator for high half
    col witness bits(64) mul_carry_lo[N_LIMBS + 1];  // Carries for low half accumulation
    col witness bits(64) mul_carry_hi[N_LIMBS + 1];  // Carries for high half accumulation

    // MUL operation selector
    const expr is_mul = is_mul_low + is_mul_high;

    // === MUL_LOW CONSTRAINTS ===
    // For the low 256 bits, we need partial products at positions 0-7.
    // Each position k accumulates: sum_{i+j=k, i<8, j<8} a[i] * b[j]
    //
    // Position 0: a[0]*b[0]
    // Position 1: a[0]*b[1] + a[1]*b[0]
    // ...
    // Position 7: a[0]*b[7] + a[1]*b[6] + ... + a[7]*b[0]

    // First, verify mul_carry_lo[0] = 0 (no initial carry)
    sel * is_mul * mul_carry_lo[0] === 0;

    // For each low position k (0..7), verify the partial product sum
    for (int k = 0; k < N_LIMBS; k++) {
        // Build the partial product sum for this position
        expr pp_sum = 0;
        for (int i = 0; i <= k; i++) {
            int j = k - i;
            if (i < N_LIMBS && j < N_LIMBS) {
                pp_sum = pp_sum + a[i] * b[j];
            }
        }
        // Also add contributions from higher pairs that wrap around via carry
        // This happens when i+j > 7 but still contributes to low positions via carry propagation

        // Constraint: pp_sum + carry_in = result[k] + carry_out * 2^32
        // Where mul_pp_lo[k] is the witness for the accumulator
        sel * is_mul * (mul_pp_lo[k] + mul_carry_lo[k] - result[k] - mul_carry_lo[k+1] * 2**32) === 0;

        // Verify mul_pp_lo[k] equals the partial product sum
        sel * is_mul * (mul_pp_lo[k] - pp_sum) === 0;
    }

    // === MUL_HIGH CONSTRAINTS ===
    // For the high 256 bits, we need partial products at positions 8-15.
    // Position 8: a[1]*b[7] + a[2]*b[6] + ... + a[7]*b[1] + overflow from position 7
    // ...
    // Position 15: a[7]*b[7] + overflow from position 14

    // Verify mul_carry_hi[0] = mul_carry_lo[8] (carry from low half)
    sel * is_mul * (mul_carry_hi[0] - mul_carry_lo[N_LIMBS]) === 0;

    for (int k = 0; k < N_LIMBS; k++) {
        int pos = k + N_LIMBS; // Position 8..15
        // Build the partial product sum for this position
        expr pp_sum_hi = 0;
        for (int i = 0; i < N_LIMBS; i++) {
            int j = pos - i;
            if (j >= 0 && j < N_LIMBS) {
                pp_sum_hi = pp_sum_hi + a[i] * b[j];
            }
        }

        // For MUL_HIGH: result[k] = high_product[k]
        sel * is_mul_high * (mul_pp_hi[k] + mul_carry_hi[k] - result[k] - mul_carry_hi[k+1] * 2**32) === 0;

        // Verify mul_pp_hi[k] equals the partial product sum (for both MUL_LOW and MUL_HIGH)
        sel * is_mul * (mul_pp_hi[k] - pp_sum_hi) === 0;
    }

    // === MUL_LOW OVERFLOW CONSTRAINTS ===
    // For MUL_LOW, overflow = 1 iff any of the high 256 bits are non-zero.
    // The high bits are computed from mul_pp_hi and mul_carry_hi.
    //
    // We compute the actual high limbs and use inverse trick to verify overflow.

    // Auxiliary columns to compute and verify high limbs for MUL_LOW
    col witness bits(32) mul_high_result[N_LIMBS];  // The computed high 256-bit result limbs
    col witness bits(1) mul_hi_nz[N_LIMBS];         // mul_hi_nz[k] = 1 if mul_high_result[k] != 0
    col witness bits(64) mul_hi_inv[N_LIMBS];       // Inverse of mul_high_result[k] when non-zero

    // For MUL_LOW: verify the high result limbs are computed correctly
    for (int k = 0; k < N_LIMBS; k++) {
        // mul_high_result[k] = (mul_pp_hi[k] + mul_carry_hi[k]) mod 2^32
        // And mul_carry_hi[k+1] = (mul_pp_hi[k] + mul_carry_hi[k]) / 2^32
        sel * is_mul_low * (mul_pp_hi[k] + mul_carry_hi[k] - mul_high_result[k] - mul_carry_hi[k+1] * 2**32) === 0;

        // Boolean constraint for mul_hi_nz
        mul_hi_nz[k] * (1 - mul_hi_nz[k]) === 0;

        // Inverse trick: mul_high_result[k] * mul_hi_inv[k] = mul_hi_nz[k]
        sel * is_mul_low * (mul_high_result[k] * mul_hi_inv[k] - mul_hi_nz[k]) === 0;

        // If mul_hi_nz[k] = 0, then mul_high_result[k] must be 0
        sel * is_mul_low * (1 - mul_hi_nz[k]) * mul_high_result[k] === 0;
    }

    // Sum of all high non-zero indicators
    const expr mul_hi_any_nz = mul_hi_nz[0] + mul_hi_nz[1] + mul_hi_nz[2] + mul_hi_nz[3]
                             + mul_hi_nz[4] + mul_hi_nz[5] + mul_hi_nz[6] + mul_hi_nz[7];

    // Inverse for checking if mul_hi_any_nz is zero
    col witness bits(64) mul_hi_any_inv;

    // overflow = 1 iff mul_hi_any_nz > 0 (i.e., any high limb is non-zero)
    // Constraint 1: mul_hi_any_nz * mul_hi_any_inv = overflow
    // (if mul_hi_any_nz != 0, then overflow must be 1)
    sel * is_mul_low * (mul_hi_any_nz * mul_hi_any_inv - overflow) === 0;

    // Constraint 2: (1 - overflow) * mul_hi_any_nz = 0
    // (if overflow = 0, then mul_hi_any_nz must be 0)
    sel * is_mul_low * (1 - overflow) * mul_hi_any_nz === 0;

    // MUL_HIGH overflow is always 0 (no bits beyond 512)
    sel * is_mul_high * overflow === 0;

    // === OPERATION BUS ===
    // Prove operation to main CPU
    lookup_proves(operation_bus_id,
        [OP_U256_DELEGATION, step, control, addr_a, addr_b, overflow, 0, 0],
        sel);
}

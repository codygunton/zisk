pragma circom 2.1.0;
pragma custom_templates;

include "{{ verifier_filename }}";
include "mux1.circom";
include "iszero.circom";

{{ check_publics_template }}

{{ aggregate_publics_template }}

{{ prepare_publics_template }}

// Helper: returns 1 iff the two 4-element VKs are element-wise equal, 0 otherwise.
template IsEqualVK() {
    signal input a[4];
    signal input b[4];
    signal output {binary} out;

    signal {binary} eq[4];
    for (var i = 0; i < 4; i++) {
        eq[i] <== IsZero()(a[i] - b[i]);
    }
    signal {binary} eq01 <== eq[0] * eq[1];
    signal {binary} eq23 <== eq[2] * eq[3];
    out <== eq01 * eq23;
}

template Main(nPublics, nPrivateInputs, nPrograms) {
    signal output aggregatedPublics[nPublics + 4];

{{ define_stark_inputs_a }}

{{ define_stark_inputs_b }}

    signal input privateInputs[nPrivateInputs];

    signal input rootCRecurserAgg[4];

    var rootCVadcopFinalZisk[4] = [{% for v in root_c_vadcop_final_zisk %}{{ v }}{% if not loop.last %},{% endif %}{% endfor %}];

    var programVKs[nPrograms][4] = [{% for vk in program_vks %}[{{ vk[0] }},{{ vk[1] }},{{ vk[2] }},{{ vk[3] }}]{% if not loop.last %},{% endif %}{% endfor %}];

    // -- Extract programVK from each proof's publics
    signal programVK_A[4];
    signal programVK_B[4];
    for (var i = 0; i < 4; i++) {
        programVK_A[i] <== a_sv_publics[nPublics + i];
        programVK_B[i] <== b_sv_publics[nPublics + i];
    }

    // -- Membership check: is the proof's programVK in the registered list?
    //    Per-program IsEqualVK feeds a running sum that's 0/1
    //    (leaf/aggregated), assuming no duplicates.
    signal {binary} eqA[nPrograms];
    signal {binary} eqB[nPrograms];
    signal accA[nPrograms + 1];
    signal accB[nPrograms + 1];
    accA[0] <== 0;
    accB[0] <== 0;
    for (var k = 0; k < nPrograms; k++) {
        eqA[k] <== IsEqualVK()(programVK_A, programVKs[k]);
        eqB[k] <== IsEqualVK()(programVK_B, programVKs[k]);
        accA[k + 1] <== accA[k] + eqA[k];
        accB[k + 1] <== accB[k] + eqB[k];
    }

    signal isRegisteredProgramA <== accA[nPrograms];
    signal isRegisteredProgramB <== accB[nPrograms];
    // Enforce binary in-circuit (the running sum isn't provably <= 1 via tags).
    isRegisteredProgramA * (isRegisteredProgramA - 1) === 0;
    isRegisteredProgramB * (isRegisteredProgramB - 1) === 0;

{{ assign_stark_inputs_a }}
{{ assign_stark_inputs_b }}

    // -- rootC: leaf (isRegisteredProgram=1) -> rootCVadcopFinalZisk; aggregated (isRegisteredProgram=0) -> programVK.
    vA.rootC <== MultiMux1(4)([programVK_A, rootCVadcopFinalZisk], isRegisteredProgramA);
    vB.rootC <== MultiMux1(4)([programVK_B, rootCVadcopFinalZisk], isRegisteredProgramB);

    // -- Strip the VK slot from each proof's publics (nPublics non-VK entries).
    signal aPublics[nPublics];
    signal bPublics[nPublics];
    for (var i = 0; i < nPublics; i++) {
        aPublics[i] <== a_sv_publics[i];
        bPublics[i] <== b_sv_publics[i];
    }

    // -- PreparePublics + mux: apply preparation to leaf inputs, pass aggregated inputs through unchanged.
    signal aPublicsPrepared[nPublics] <== PreparePublics(nPublics, nPrivateInputs)(aPublics, privateInputs);
    signal bPublicsPrepared[nPublics] <== PreparePublics(nPublics, nPrivateInputs)(bPublics, privateInputs);

    signal ziskPublicsA[nPublics];
    signal ziskPublicsB[nPublics];
    for (var i = 0; i < nPublics; i++) {
        ziskPublicsA[i] <== Mux1()([aPublics[i], aPublicsPrepared[i]], isRegisteredProgramA);
        ziskPublicsB[i] <== Mux1()([bPublics[i], bPublicsPrepared[i]], isRegisteredProgramB);
    }

    // -- Consistency + aggregation (VK-agnostic).
    CheckPublics(nPublics, nPrivateInputs)(ziskPublicsA, ziskPublicsB, privateInputs);
    signal aggPublics[nPublics] <== AggregatePublics(nPublics, nPrivateInputs)(ziskPublicsA, ziskPublicsB, privateInputs);

    for (var i = 0; i < nPublics; i++) {
        aggregatedPublics[i] <== aggPublics[i];
    }

    // -- When both proofs are aggregated, their programVKs must match (committed invariant).
    signal bothAggregated <== (1 - isRegisteredProgramA) * (1 - isRegisteredProgramB);
    for (var i = 0; i < 4; i++) {
        bothAggregated * (programVK_A[i] - programVK_B[i]) === 0;
    }

    // -- Output programVK selection:
    //      both leaves          -> rootCRecurserAgg (this aggregator's free input)
    //      A aggregated         -> programVK_A (covers "A agg, B leaf" and "both agg")
    //      A leaf, B aggregated -> programVK_B
    //    Selectors are mutually exclusive and sum to 1.
    signal selectAgg <== isRegisteredProgramA * isRegisteredProgramB;
    signal selectAVK <== 1 - isRegisteredProgramA;
    signal selectBVK <== isRegisteredProgramA * (1 - isRegisteredProgramB);

    for (var i = 0; i < 4; i++) {
        aggregatedPublics[nPublics + i] <== selectAgg * rootCRecurserAgg[i] + selectAVK * programVK_A[i] + selectBVK * programVK_B[i];
    }
}

component main = Main(64, {{ n_private_inputs }}, {{ n_programs }});

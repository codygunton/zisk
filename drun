#!/bin/bash
set -e

IMAGE_NAME="zisk-os"
CONTAINER_NAME="zisk-os-run"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

show_help() {
    echo "Usage: ./drun {build|execute [-a]|prove|shell}"
    echo ""
    echo "Commands:"
    echo "  build              Build the Docker image (clones from remote)"
    echo "  execute            Execute Ethereum block with ZisK emulator"
    echo "  execute -a         Execute Ethereum block with Airbender"
    echo "  prove              Run GPU proving (requires NVIDIA GPU)"
    echo "  shell              Interactive shell in container"
    echo ""
    echo "Environment Variables:"
    echo "  BLOCK=<number>     Block number to execute/prove (default: 24198369)"
    echo "  VERBOSE=1          Enable verbose output"
    echo "  REPO_URL=<url>     Git repository URL (default: https://github.com/codygunton/zisk)"
    echo "  BRANCH=<branch>    Git branch to clone (default: zisk-integration)"
    echo ""
    echo "Requirements:"
    echo "  - Docker"
    echo "  - NVIDIA Container Toolkit (for 'prove' command)"
    echo ""
    echo "Note: Proving key is built into the image. Mount ./provingKey to override."
}

build_image() {
    local BUILD_ARGS=()

    # Allow overriding repo URL and branch via environment variables
    [ -n "$REPO_URL" ] && BUILD_ARGS+=(--build-arg "REPO_URL=$REPO_URL")
    [ -n "$BRANCH" ] && BUILD_ARGS+=(--build-arg "BRANCH=$BRANCH")

    echo "Building Docker image..."
    [ -n "$REPO_URL" ] && echo "  REPO_URL=$REPO_URL"
    [ -n "$BRANCH" ] && echo "  BRANCH=$BRANCH"

    docker build "${BUILD_ARGS[@]}" \
        -t "$IMAGE_NAME:latest" \
        "$SCRIPT_DIR"
    echo "Built $IMAGE_NAME:latest"
}

check_image() {
    if ! docker image inspect "$IMAGE_NAME:latest" > /dev/null 2>&1; then
        echo "Error: Docker image '$IMAGE_NAME:latest' not found."
        echo "Run './drun build' first to build the image."
        exit 1
    fi
}

run_container() {
    local CMD="$1"
    shift

    check_image

    local DOCKER_ARGS=(
        --rm
        --name "$CONTAINER_NAME"
    )

    # Add interactive mode only for shell command or if TTY available
    if [ "$CMD" = "shell" ]; then
        DOCKER_ARGS+=(-it)
    elif [ -t 0 ]; then
        DOCKER_ARGS+=(-t)
    fi

    # Add GPU support for prove command
    if [ "$CMD" = "prove" ]; then
        if ! command -v nvidia-smi &> /dev/null; then
            echo "Error: nvidia-smi not found. GPU proving requires NVIDIA drivers."
            exit 1
        fi
        DOCKER_ARGS+=(--gpus all)
        # Optionally mount local proving key to override the built-in one
        if [ -d "$SCRIPT_DIR/provingKey" ]; then
            DOCKER_ARGS+=(-v "$SCRIPT_DIR/provingKey:/workspace/provingKey:ro")
        fi
    fi

    # Pass through environment variables
    [ -n "$BLOCK" ] && DOCKER_ARGS+=(-e "BLOCK=$BLOCK")
    [ -n "$VERBOSE" ] && DOCKER_ARGS+=(-e "VERBOSE=$VERBOSE")

    docker run "${DOCKER_ARGS[@]}" "$IMAGE_NAME:latest" "$CMD" "$@"
}

case "${1:-}" in
    build)
        build_image
        ;;
    execute)
        shift
        run_container execute "$@"
        ;;
    prove)
        shift
        run_container prove "$@"
        ;;
    shell)
        run_container shell
        ;;
    -h|--help|help|"")
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac

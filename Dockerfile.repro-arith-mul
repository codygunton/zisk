# GPU build: CUDA devel image supplies nvcc + CUDA libs. Runs on GPU at
# runtime when started with `docker run --gpus all`.
FROM nvidia/cuda:13.1.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_TARGET_DIR=/workspace/zisk/target-docker
ENV PATH=/root/.cargo/bin:$PATH
ENV CC=clang
ENV CXX=clang++
ENV CXXFLAGS=-std=c++17
# RTX 5090 (Blackwell) is compute capability 12.0.
ENV CUDA_ARCH=sm_120

RUN apt-get update && apt-get install -y \
    curl \
    git \
    ca-certificates \
    build-essential \
    clang \
    libclang-dev \
    libstdc++-14-dev \
    pkg-config \
    cmake \
    jq \
    xz-utils \
    libomp-dev \
    libgmp-dev \
    nlohmann-json3-dev \
    protobuf-compiler \
    uuid-dev \
    libgrpc++-dev \
    libsecp256k1-dev \
    libsodium-dev \
    libpqxx-dev \
    nasm \
    libopenmpi-dev \
    openmpi-bin \
    openmpi-common \
    gcc-riscv64-unknown-elf \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable

WORKDIR /workspace/zisk
RUN git config --global --add safe.directory '*'
COPY . .

# ZisK v0.18.0 links CUDA by default; `cpu-only` is the opt-out feature, so a
# plain build (without it) is GPU-capable.
RUN cargo build --release --bin cargo-zisk

RUN mkdir -p /tmp/zisk-mul-edge \
    && riscv64-unknown-elf-gcc \
        -march=rv64imac \
        -mabi=lp64 \
        -nostdlib \
        -nostartfiles \
        -static \
        -Ttext=0x80000000 \
        elf-regressions/arith_bad_mul/test.s \
        -o /tmp/zisk-mul-edge/arith_bad_mul.elf

RUN install -Dm755 ziskup/ziskup /usr/local/bin/ziskup

CMD ["bash", "repro-arith-mul.sh"]
